    "history": "^3.0.0",
    "html-to-text": "^4.0.0",
    "keycode": "^2.1.4",
    "localStorage": "^1.0.3",
    "lodash": "^4.17.21",
    "messageformat": "^0.2.2",
    "moment": "^2.27.0",
