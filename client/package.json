{
  "name": "OpenSupports",
  "version": "4.11.0",
  "author": "Ivan Diaz <contact@opensupports.com>",
  "description": "Open source ticket system made with PHP and ReactJS",
  "repository": {
    "type": "git",
    "url": "https://github.com/opensupports/opensupports"
  },
  "private": false,
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=development OS_GLOBAL_INDEX_PATH=/app webpack serve --progress",
    "start-fixtures": "cross-env NODE_ENV=development OS_GLOBAL_INDEX_PATH=/app webpack serve --env FIXTURES=1 --progress",
    "format": "prettier --write \"src/**/*.{ts,scss,html}\" --config .prettierrc",
    "build": "cross-env NODE_ENV=production rimraf build && webpack --mode production --devtool false",
    "test": "cross-env NODE_PATH=src mocha src/lib-test/preprocessor.js --require @babel/register --recursive src/**/**/__tests__/*-test.js"
  },
  "devDependencies": {
    "@babel/cli": "^7.5.5",
    "@babel/core": "^7.5.5",
    "@babel/node": "^7.5.5",
    "@babel/plugin-proposal-class-properties": "^7.4.4",
    "@babel/plugin-transform-modules-commonjs": "^7.5.0",
    "@babel/preset-env": "^7.5.5",
    "@babel/preset-react": "^7.0.0",
    "@babel/register": "^7.5.5",
    "axios-mock-adapter": "^1.15.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-add-module-exports": "^1.0.2",
    "browser-sync": "^2.27.5",
    "chai": "^3.5.0",
    "copy-webpack-plugin": "^13.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "debowerify": "^1.3.1",
    "del": "^1.2.0",
    "eslint": "^5.16.0",
    "express": "^4.13.1",
    "express-http-proxy": "^0.6.0",
    "html-webpack-plugin": "^5.6.3",
    "humps": "^0.6.0",
    "jsdom": "^8.4.1",
    "mocha": "^6.2.0",
    "morgan": "^1.6.1",
    "nodemon": "^1.19.1",
    "path": "^0.12.7",
    "prettier": "^3.0.3",
    "proxyquire": "^1.7.4",
    "react-addons-test-utils": "^15.0.1",
    "rimraf": "^6.0.1",
    "run-sequence": "^1.1.1",
    "sass": "^1.89.0",
