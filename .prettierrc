{
  "bracketSameLine": true,
  "endOfLine": "lf",
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 120,
  "tabWidth": 2,
  "semi": true,
  "overrides": [
    {
      "files": ["*.scss", "*.css"],
      "options": {
        "printWidth": 80,
        "singleQuote": false
      }
    }
  ]
}
